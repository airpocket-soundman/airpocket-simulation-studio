          "maxOutboxBytes": 8000000,
          "maxTotalEvents": 16,
          "maxTotalBytes": 16000000,
          "terminalControlMaxEvents": 1,
          "terminalControlMaxBytes": 4096,
          "byteBasis": "conservative-structural-envelope-estimate-including-transport-metadata",
