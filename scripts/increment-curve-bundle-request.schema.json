{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic independent linear increment curve generator request",
  "description": "Dedicated generator request, not a Studio project or derived table. Runtime additionally checks finite values, 64 KiB/graph/depth budgets, positive box spans, gauge/area geometry, exact accepted axes within 1e-12 and mesh work limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "synthetic",
    "curveId",
    "caseIdentity",
    "rowIdentity",
    "boundsMm",
    "meshSizeMm",
    "youngModulusPa",
    "poissonRatio",
    "axis",
    "initialGaugeLengthMm",
    "initialAreaMm2"
  ],
  "properties": {
    "synthetic": {
      "const": true
    },
    "curveId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "caseIdentity": {
      "type": "object",
      "minProperties": 1
    },
    "rowIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialKey",
        "geometryKey",
        "gaugeKey"
      ],
      "properties": {
        "materialKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "geometryKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "gaugeKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        }
      }
    },
    "boundsMm": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "number",
        "minimum": -1000000,
        "maximum": 1000000
      },
      "description": "xmin,ymin,zmin,xmax,ymax,zmax in mm; positive spans required."
    },
    "meshSizeMm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "youngModulusPa": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "poissonRatio": {
      "type": "number",
      "exclusiveMinimum": -1,
      "exclusiveMaximum": 0.49
    },
    "axis": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      },
      "description": "One positive coordinate axis [1,0,0], [0,1,0], [0,0,1], component tolerance 1e-12; runtime checked."
    },
    "initialGaugeLengthMm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "initialAreaMm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "controlledQuantity": {
      "enum": [
        "force",
        "displacement"
      ]
    },
    "loadsN": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "number"
      }
    },
    "displacementsMm": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "number"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "controlledQuantity": {
          "const": "force"
        }
      },
      "required": [
        "loadsN"
      ],
      "not": {
        "required": [
          "displacementsMm"
        ]
      }
    },
    {
      "properties": {
        "controlledQuantity": {
          "const": "displacement"
        }
      },
      "required": [
        "controlledQuantity",
        "displacementsMm"
      ],
      "not": {
        "required": [
          "loadsN"
        ]
      }
    }
  ]
}
