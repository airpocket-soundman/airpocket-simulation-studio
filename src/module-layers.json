 "allowlist": [
  {
   "kind": "external",
   "from": "project-import.js",
   "to": "three",
   "reason": "Pre-existing: STL import uses three.js STLLoader/geometry inside the operations layer. Remove by moving STL parsing to a pure domain parser (MOD1 follow-up)."
  },
  {
   "kind": "external",
   "from": "project-import.js",
   "to": "three/addons/loaders/STLLoader.js",
   "reason": "Pre-existing: STLLoader dependency of project-import.js; same follow-up as the three import."
  },
  {
   "kind": "external",
   "from": "print-zip.js",
   "to": "three/addons/libs/fflate.module.js",
   "reason": "Pre-existing: 3MF zip writer borrows fflate bundled with three.js; replace with a direct fflate dependency or own zip writer."
  },
  {
   "kind": "edge",
   "from": "analysis-client.js",
   "to": "analysis.worker.js",
   "reason": "Intentional: the session client starts the analysis worker via new Worker(new URL(...,import.meta.url)); it is a runtime process boundary (messages only, no shared imports), not a code import. Worker layer is deliberately not in session mayImport."
  },
  {
   "kind": "dom",
   "from": "analysis-client.js",
   "to": "new Worker",
   "reason": "Intentional: analysis-client.js is the only session module that spawns the analysis Web Worker (createWorker, overridable in tests via runtime.createWorker)."
  },
  {
   "kind": "edge",
   "from": "main.js",
   "to": "cad.worker.js",
   "reason": "Intentional: main.js starts the CAD worker via new Worker(new URL(...,import.meta.url)); a runtime process boundary, not a code import."
  },
  {
   "kind": "dom",
   "from": "analysis.worker.js",
   "to": "fetch()",
   "reason": "Intentional: the analysis worker fetches its WASM binaries (data.base + path) itself; fetch is available in worker scope and is not DOM access."
  }
 ]
}
